# =============================================================================
# Enterprise AI Assistant — environment template
#
# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
#
# Every value here is safe to read without secrets. Never commit a real `.env`.
# Nothing in this file is required to boot the API: the health endpoint must
# work with an empty configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins for CORS.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# LLM provider abstraction
#
# LLM_MODEL must be a LiteLLM model identifier (provider prefix + model name).
# Verified at bootstrap time (see docs/architecture/TECH_STACK.md):
#   gemini/gemini-3.5-flash-lite   -> Google AI Studio, function calling support
# The model id is configuration, never a hardcoded architectural dependency.
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30

# Free-tier Gemini may use submitted content to improve Google products.
# Only synthetic, non-sensitive data may be sent while this key is free-tier.
GEMINI_API_KEY=

# Hard ceiling on tool-execution rounds per user turn (see SECURITY.md).
AGENT_MAX_TOOL_ROUNDS=3

# -----------------------------------------------------------------------------
# Supabase (application persistence + authentication)
#
# Phase 2 wires real usage. Empty values must not break the API skeleton.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: backend only,
# never exposed to the browser and never passed to the LLM.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# External data connectors (read-only, Phase 4)
#
# The application's own storage is intentionally separate from these sources.
# Didar24 API availability is still unverified; do not assume a public API.
# -----------------------------------------------------------------------------
DIDAR_API_BASE_URL=
DIDAR_API_KEY=
DIDAR_TIMEOUT_SECONDS=10

# Read-only credential for the PostgreSQL connector. NOT the app database URL.
CONNECTOR_POSTGRES_URL=

# -----------------------------------------------------------------------------
# Frontend (Vite, build-time — prefix VITE_ is required to reach the browser)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
