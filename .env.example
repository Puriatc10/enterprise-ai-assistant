# =============================================================================
# Enterprise AI Assistant — environment template
#
# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
#
# Every value here is safe to read without secrets. Never commit a real `.env`.
# Nothing in this file is required to boot the API: the health endpoint must
# work with an empty configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins for CORS.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# LLM provider abstraction
#
# LLM_MODEL must be a LiteLLM model identifier (provider prefix + model name).
# Verified in Phase 1 (2026-11-14, docs/analysis/PHASE1-LLM.md): OpenRouter's
# nemotron-3-ultra-550b route is free, tool-capable, 1M context, 1.1–7.7 s.
# Free pools are shared and rate-capped: keep a fallback id (see TECH_STACK.md).
# -----------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT_SECONDS=45

# Free tier/route terms matter: OpenRouter may log or train on free-model traffic,
# so only synthetic or non-sensitive data may be sent (see SECURITY.md §6).
OPENROUTER_API_KEY=

# Alternative provider, kept for later. Currently not entitled (no free tier on
# this project), so it is not the MVP path.
GEMINI_API_KEY=

# Hard ceiling on tool-execution rounds per user turn (see SECURITY.md).
AGENT_MAX_TOOL_ROUNDS=3

# -----------------------------------------------------------------------------
# Supabase (application persistence + authentication)
#
# Filled from the dev project: Project Settings → API.
# There is deliberately NO service_role key here. The backend forwards the
# caller's own access token to PostgREST, so row-level security enforces scope;
# a key that bypasses RLS would disable the control this design relies on.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Audience Supabase stamps into access tokens; "authenticated" is its default.
SUPABASE_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# External data connectors (read-only, Phase 4)
#
# The application's own storage is intentionally separate from these sources.
# Didar24 API availability is still unverified; do not assume a public API.
# -----------------------------------------------------------------------------
DIDAR_API_BASE_URL=
DIDAR_API_KEY=
DIDAR_TIMEOUT_SECONDS=10

# Read-only credential for the PostgreSQL connector. NOT the app database URL.
# The role should hold SELECT on the connector views/tables and nothing else;
# the adapter additionally wraps every query in a READ ONLY transaction.
CONNECTOR_POSTGRES_URL=

# Which adapter answers policy questions: mock | postgres
# mock needs no configuration and is the demonstration path (ADR-0002).
POLICIES_SOURCE=mock
POSTGRES_ROW_LIMIT=50
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Frontend (Vite, build-time — prefix VITE_ is required to reach the browser)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
