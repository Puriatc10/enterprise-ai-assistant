# Normalize line endings so Windows checkouts do not produce spurious diffs and
# files copied into Linux containers keep LF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

*.bat text eol=crlf
*.cmd text eol=crlf

# Lockfiles: generated, but reviewed — not diff-suppressed on purpose.
